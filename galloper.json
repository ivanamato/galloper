{
  "default": "claude-haiku",
  "defaultPlanner": "claude-opus-high-effort",
  "defaultExecutioner": "claude-haiku",
  "commands": {
    "codex": {
      "command": "codex exec --json --skip-git-repo-check -",
      "allowedSubcommands": ["single-prompt", "plan", "pipeline"],
      "disallowedSubcommands": []
    },
    "claude-haiku": {
      "command": "claude -p --model claude-haiku-4-5-20251001 --allowedTools * --dangerously-skip-permissions",
      "allowedSubcommands": ["single-prompt", "plan", "implement", "pipeline"],
      "disallowedSubcommands": [],
      "env": {}
    },
    "claude-opus-high-effort": {
      "command": "claude -p --model claude-opus-4-7 --effort high --allowedTools * --dangerously-skip-permissions",
      "allowedSubcommands": ["single-prompt", "plan", "implement", "pipeline"],
      "disallowedSubcommands": []
    },
    "zai": {
      "command": "claude -p --allowedTools * --dangerously-skip-permissions",
      "allowedSubcommands": ["single-prompt", "plan", "implement", "pipeline"],
      "disallowedSubcommands": [],
      "env": {
        "CLAUDE_CODE_NO_FLICKER": "1",
        "ENABLE_LSP_TOOLS": "1",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.1",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-4.7",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.5-air",
        "ANTHROPIC_AUTH_TOKEN": "3b5f3157d71446c2907fa4a3ab300d54.3i1l7S0Phy8FfPhj",
        "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
        "API_TIMEOUT_MS": "3000000"
      }
    },
    "zaiturbo": {
      "command": "claude -p --allowedTools * --dangerously-skip-permissions",
      "allowedSubcommands": ["single-prompt", "plan", "implement", "pipeline"],
      "disallowedSubcommands": [],
      "env": {
        "ENABLE_LSP_TOOLS": "1",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-4.5-air",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-4.5-air",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.5-air",
        "ANTHROPIC_AUTH_TOKEN": "3b5f3157d71446c2907fa4a3ab300d54.3i1l7S0Phy8FfPhj",
        "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
        "API_TIMEOUT_MS": "3000000"
      }
    }
  },
  "hooks": {
    "lifecycle": {
      "pre-plan": [
        {
          "command": "echo \"[pre-plan] $(date -u +%Y-%m-%dT%H:%M:%SZ) starting plan\" >> galloper-data/hooks.log",
          "timeoutMs": 5000,
          "onFailure": "warn"
        }
      ],
      "post-plan": [
        {
          "command": "echo \"[post-plan] $(date -u +%Y-%m-%dT%H:%M:%SZ) plan generated\" >> galloper-data/hooks.log",
          "timeoutMs": 5000,
          "onFailure": "warn"
        }
      ],
      "pre-task": [
        {
          "command": "echo \"[pre-task] $(date -u +%Y-%m-%dT%H:%M:%SZ) task starting\" >> galloper-data/hooks.log",
          "timeoutMs": 5000,
          "onFailure": "warn"
        }
      ],
      "post-task": [
        {
          "command": "echo \"[post-task] $(date -u +%Y-%m-%dT%H:%M:%SZ) task finished\" >> galloper-data/hooks.log",
          "timeoutMs": 5000,
          "onFailure": "warn"
        },
        {
          "command": "npm run build 2>&1 | tail -30",
          "timeoutMs": 60000,
          "onFailure": "warn"
        },
        {
          "command": "npm run test:unit -- --reporter=basic 2>&1 | tail -20",
          "timeoutMs": 120000,
          "onFailure": "warn"
        }
      ],
      "pre-task-file": [
        {
          "match": "src/**/*.ts",
          "instructions": "Strict TypeScript. ESM: use `.js` extensions in relative imports (e.g. `./Foo.js`, not `./Foo` or `./Foo.ts`). Avoid `any`; prefer explicit interfaces. Match existing JSDoc style — concise top-of-function blocks explaining intent + non-obvious invariants."
        },
        {
          "match": "tests/**/*.test.ts",
          "instructions": "Vitest. Import source modules via `../../src/lib/X.js` (note the `.js` suffix). Unit tests live in `tests/unit/`, integration in `tests/integration/`. Shared fixtures and helpers live in `tests/helpers/`. Existing integration tests show the `runPlanHarness` pattern for spawning TaskRunner against a temp git repo."
        }
      ],
      "post-task-file": [
        {
          "match": "tests/unit/**/*.test.ts",
          "shell": false,
          "command": ["npx", "vitest", "run", "{file}"],
          "timeoutMs": 60000,
          "onFailure": "warn"
        }
      ]
    },
    "events": {
      "run.started": [
        {
          "command": "echo \"[event:run.started] $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> galloper-data/hooks.log",
          "timeoutMs": 3000
        }
      ],
      "run.completed": [
        {
          "command": "echo \"[event:run.completed] $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> galloper-data/hooks.log",
          "timeoutMs": 3000
        }
      ],
      "task.completed": [
        {
          "command": "echo \"[event:task.completed] $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> galloper-data/hooks.log",
          "timeoutMs": 3000
        }
      ]
    }
  }
}
